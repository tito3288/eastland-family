---
import { practice } from "../lib/practice";

interface Props {
  showAfterHours?: boolean;
}

const { showAfterHours = false } = Astro.props;
---

<aside class="reveal reveal-right glow rounded-4xl bg-white p-6 sm:rounded-5xl sm:p-8" aria-labelledby="office-details-heading">
  <p class="text-xs font-bold tracking-[.2em] text-eucalyptus uppercase">Office details</p>
  <h2 id="office-details-heading" class="mt-4 font-heading text-3xl">Plan your visit</h2>
  <dl class="mt-6 space-y-5 text-body">
    <div>
      <dt class="font-bold text-navy">Call</dt>
      <dd class="mt-1"><a class="hover:text-blue" href={practice.phoneHref}>{practice.phoneDisplay}</a></dd>
    </div>
    <div>
      <dt class="font-bold text-navy">Email</dt>
      <dd class="mt-1"><a class="break-all hover:text-blue" href={`mailto:${practice.email}`}>{practice.email}</a></dd>
    </div>
    <div>
      <dt class="font-bold text-navy">Visit</dt>
      <dd class="mt-1">
        <a class="hover:text-blue" href={practice.mapsUrl} target="_blank" rel="noopener noreferrer">
          {practice.address.street}<br />{practice.address.cityStateZip}
        </a>
      </dd>
    </div>
  </dl>
  <div class="mt-7 border-t border-powder pt-6">
    <h3 class="font-bold text-navy">Office hours</h3>
    <dl class="mt-3 space-y-2 text-sm text-body">
      {practice.hours.map((item) => (
        <div class="flex justify-between gap-4">
          <dt>{item.days}</dt>
          <dd class="text-right font-semibold text-navy">{item.hours}</dd>
        </div>
      ))}
    </dl>
  </div>
  {showAfterHours && (
    <p class="mt-6 rounded-3xl bg-air p-4 text-sm leading-relaxed text-body">
      An emergency answering service responds to questions and concerns after the office closes. Please call before arriving; the office closes to walk-in patients after the final scheduled appointment of the day.
    </p>
  )}
</aside>

