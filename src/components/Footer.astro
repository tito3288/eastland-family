---
import { practice } from "../lib/practice";
import { appointmentHref } from "../lib/features";

const currentYear = new Date().getFullYear();
---

<footer class="mt-10 overflow-hidden rounded-t-[2.75rem] bg-sand sm:mt-14 sm:rounded-t-[4.5rem]">
  <div class="reveal mx-auto max-w-7xl px-6 py-10 sm:px-8 sm:py-12 lg:px-10 lg:py-14">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between lg:gap-12">
      <div class="flex flex-col gap-4 text-center sm:flex-row sm:items-center sm:gap-6 sm:text-left">
        <a href="/" aria-label="Eastland Family Dental home">
          <img
            src="/images/eastland-logo.png"
            alt="Eastland Family Dental logo"
            width="500"
            height="500"
            loading="lazy"
            decoding="async"
            class="mx-auto h-20 w-auto max-w-[255px] object-contain sm:mx-0 sm:h-24 sm:max-w-[350px] lg:h-28 lg:max-w-[430px]"
          />
        </a>
        <div class="text-sm leading-relaxed text-body sm:text-base">
          <p class="font-bold text-navy">{practice.name}</p>
          <p>{practice.address.street}</p>
          <p>{practice.address.cityStateZip}</p>
        </div>
      </div>
      <div class="grid w-full grid-cols-1 gap-3 sm:grid-cols-2 lg:w-auto">
        <a href={practice.phoneHref} class="rounded-full bg-porcelain px-6 py-3.5 text-center font-bold text-navy">{practice.phoneDisplay}</a>
        <a href={appointmentHref} class="rounded-full bg-navy px-6 py-3.5 text-center font-bold text-white">Book Appointment</a>
      </div>
    </div>
  </div>

  <div class="bg-navy text-white/70">
    <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-2 px-6 py-5 text-center text-xs sm:px-8 sm:text-sm lg:flex-row lg:px-10 lg:text-left">
      <p>© {currentYear} {practice.name}. All rights reserved.</p>
      <p>Family dental care for children and adults in Independence, MO.</p>
      <p>Monday–Thursday, 7:00 AM–4:30 PM</p>
    </div>
  </div>
</footer>
