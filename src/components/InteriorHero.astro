---
interface Props {
  eyebrow: string;
  title: string;
  intro: string;
}

const { eyebrow, title, intro } = Astro.props;
---

<section class="relative overflow-hidden px-4 pt-8 pb-10 sm:pt-12 sm:pb-14">
  <div class="absolute top-0 right-0 -z-10 h-64 w-64 rounded-full bg-air sm:h-96 sm:w-96"></div>
  <div class="reveal reveal-zoom mx-auto max-w-7xl overflow-hidden rounded-4xl bg-sand px-6 py-12 sm:rounded-6xl sm:px-10 sm:py-16 lg:px-16 lg:py-20">
    <div class="max-w-4xl">
      <p class="text-xs font-bold tracking-[.22em] text-eucalyptus uppercase sm:text-sm">{eyebrow}</p>
      <h1 class="mt-4 font-heading text-4xl leading-[1.02] tracking-tight sm:text-5xl md:text-7xl">{title}</h1>
      <p class="mt-6 max-w-3xl text-base leading-relaxed text-body sm:text-lg md:text-xl">{intro}</p>
    </div>
  </div>
</section>

