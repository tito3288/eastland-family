---
import { practice } from "../lib/practice";

const faqs = [
  {
    question: "Do you welcome children and adults?",
    answer: "Yes. Eastland Family Dental provides family-focused care for children and adults, from routine visits to more involved treatment.",
  },
  {
    question: "How do I request an appointment?",
    answer: `Call ${practice.phoneDisplay} to request an appointment. Our scheduling coordinator will follow up to confirm your visit.`,
    delay: "80ms",
  },
  {
    question: "What payment and financing options are available?",
    answer: "The office accepts cash, personal checks, debit cards, and most major credit cards. CareCredit financing is also available for qualifying patients.",
    delay: "160ms",
  },
];
---

<section id="faq" class="px-4 py-14 sm:py-16">
  <div class="mx-auto max-w-4xl">
    <h2 class="reveal text-center font-heading text-4xl leading-tight md:text-6xl">Before Your First Visit</h2>
    <div class="mt-10 space-y-3">
      {faqs.map((item) => (
        <details class="reveal glow rounded-3xl bg-white p-5 sm:p-6" style={item.delay ? `--reveal-delay:${item.delay}` : undefined}>
          <summary class="cursor-pointer font-bold">{item.question}</summary>
          <p class="mt-3 text-body">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
