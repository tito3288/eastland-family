---
import { practice } from "../lib/practice";
---

<section class="overflow-x-clip px-4 py-8 sm:py-10" aria-labelledby="sedation-strip-title">
  <div class="reveal reveal-zoom mx-auto grid max-w-7xl overflow-hidden rounded-4xl bg-navy text-white sm:rounded-6xl lg:grid-cols-[1.3fr_.7fr]">
    <div class="p-7 sm:p-10 lg:p-14">
      <p class="text-xs font-bold tracking-[.22em] text-air uppercase sm:text-sm">Comfort options at Eastland</p>
      <h2 id="sedation-strip-title" class="mt-4 max-w-3xl font-heading text-4xl leading-tight sm:text-5xl md:text-6xl">Relax. We Offer Sedation Dentistry.</h2>
      <p class="mt-5 max-w-3xl text-base leading-relaxed text-white/75 sm:text-lg">
        Nervous about the dentist? You are not alone. Eastland Family Dental accepts Medicaid for sedation dentistry and offers care supported by a board-eligible anesthesiologist. Eligibility and benefits are verified before treatment, and nitrous oxide is available for children and adults when appropriate.
      </p>
      <div class="mt-7 flex flex-col gap-3 sm:flex-row">
        <a class="rounded-full bg-blue px-7 py-4 text-center font-bold text-white transition hover:bg-white hover:text-navy" href="/procedures/sedation-dentistry/">Explore Sedation Dentistry <span aria-hidden="true">→</span></a>
        <a class="rounded-full border border-white/25 px-7 py-4 text-center font-bold text-white transition hover:border-white hover:bg-white hover:text-navy" href={practice.phoneHref}>Call {practice.phoneDisplay}</a>
      </div>
    </div>

    <div class="relative flex min-h-64 items-end overflow-hidden bg-air p-7 text-navy sm:p-10 lg:min-h-full">
      <div class="absolute -top-20 -right-20 h-64 w-64 rounded-full border-[3rem] border-white/45" aria-hidden="true"></div>
      <div class="absolute top-14 left-10 h-24 w-24 rounded-full bg-sand" aria-hidden="true"></div>
      <div class="relative max-w-sm rounded-4xl bg-white/90 p-6 shadow-xl shadow-navy/10 backdrop-blur sm:p-7">
        <p class="text-xs font-bold tracking-[.2em] text-eucalyptus uppercase">An added level of support</p>
        <p class="mt-3 font-heading text-2xl leading-snug sm:text-3xl">A board-eligible anesthesiologist helps support a carefully planned, comfort-focused visit.</p>
      </div>
    </div>
  </div>
</section>
