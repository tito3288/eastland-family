---
const services = [
  {
    title: "Cleanings & Prevention",
    description: "Routine exams, professional cleanings, dental X-rays, and sealants.",
    tone: "bg-air",
    href: "/procedures/cleanings-prevention/",
  },
  {
    title: "Cosmetic Dentistry",
    description: "Teeth whitening, porcelain veneers, and tooth-colored fillings.",
    tone: "bg-sand",
    href: "/procedures/cosmetic-dentistry/",
    delay: "80ms",
  },
  {
    title: "Pediatric & Family Care",
    description: "Welcoming dental care for children and adults in a calm, reassuring office.",
    tone: "bg-powder",
    href: "/procedures/pediatric-dentistry/",
    delay: "160ms",
  },
  {
    title: "Restorative Dentistry",
    description: "Same-day CEREC crowns, bridges, implants, and dentures personalized for your smile.",
    tone: "bg-powder",
    href: "/procedures/restorations/",
  },
  {
    title: "Oral Surgery",
    description: "Comfort-minded extractions, wisdom teeth removal, and bone grafting when needed.",
    tone: "bg-air",
    href: "/procedures/oral-maxillofacial-surgery/",
    delay: "80ms",
  },
  {
    title: "Root Canal Therapy",
    description: "Care for infected, damaged, or cracked teeth with comfort at the center.",
    tone: "bg-navy text-white",
    bodyTone: "text-white/70",
    href: "/procedures/endodontics/",
    delay: "160ms",
  },
];
---

<section id="choose" class="px-4 py-14 sm:py-16">
  <div class="mx-auto max-w-7xl">
    <div class="reveal mx-auto max-w-3xl text-center">
      <p class="text-xs font-bold tracking-[.22em] text-eucalyptus uppercase sm:text-sm">Choose Your Care</p>
      <h2 class="mt-4 font-heading text-4xl leading-tight md:text-6xl">Comprehensive Care for Every Stage of Your Smile.</h2>
    </div>
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((service) => (
        <a
          href={service.href}
          class:list={["reveal group min-h-[155px] rounded-4xl p-6 transition hover:-translate-y-1 sm:min-h-[175px] sm:rounded-5xl sm:p-7", service.tone]}
          style={service.delay ? `--reveal-delay:${service.delay}` : undefined}
        >
          <h3 class="text-2xl font-bold">{service.title}</h3>
          <p class:list={["mt-3", service.bodyTone ?? "text-body"]}>{service.description}</p>
          <span class:list={["mt-5 inline-flex font-bold", service.bodyTone ?? "text-blue"]}>Learn more <span class="ml-2 transition group-hover:translate-x-1" aria-hidden="true">→</span></span>
        </a>
      ))}
    </div>
    <div class="reveal mt-8 text-center">
      <a class="inline-flex rounded-full bg-navy px-7 py-4 font-bold text-white" href="/procedures/">Explore all procedures</a>
    </div>
  </div>
</section>
