---
import InteriorLayout from "../../../layouts/InteriorLayout.astro";
import { practice } from "../../../lib/practice";
import { appointmentHref } from "../../../lib/features";

const path = "/procedures/sedation-dentistry/";
const siteOrigin = Astro.site ?? new URL("https://www.eastlandfamilydental.com");

const faqs = [
  {
    question: "Is sedation dentistry safe?",
    answer: "Every sedation recommendation begins with a review of your health history, medications, treatment needs, and concerns. Eastland Family Dental has a board-eligible anesthesiologist to support sedation care, and the team will explain the monitoring and instructions that apply to your plan.",
  },
  {
    question: "Will I be asleep during my procedure?",
    answer: "Not with nitrous oxide. It is intended to help you relax while remaining awake and able to respond. If you are looking for a different level of sedation, ask the team which options are available and appropriate for your care.",
  },
  {
    question: "Which type of sedation is right for me?",
    answer: "The right approach depends on your health history, anxiety level, age, and the treatment being planned. The clinical team will review those factors with you before recommending an option.",
  },
  {
    question: "Can my child receive sedation for an appointment?",
    answer: "Nitrous oxide is available for children and adults when appropriate. The team will consider your child’s age, health history, comfort, and treatment needs before making a recommendation.",
  },
  {
    question: "Does insurance cover sedation dentistry?",
    answer: "Coverage varies by plan and procedure. Contact the office so the team can review your benefits and discuss expected costs before treatment.",
  },
  {
    question: "How do I get started?",
    answer: `Call ${practice.phoneDisplay} or request an appointment online. Tell the team about your concerns, and they will help you understand the next step before your visit.`,
  },
];

const additionalStructuredData = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", siteOrigin).toString() },
      { "@type": "ListItem", position: 2, name: "Procedures", item: new URL("/procedures/", siteOrigin).toString() },
      { "@type": "ListItem", position: 3, name: "Sedation Dentistry", item: new URL(path, siteOrigin).toString() },
    ],
  },
];

const reasons = [
  "You feel nervous, anxious, or fearful about dental treatment",
  "You have a sensitive gag reflex",
  "You have difficulty becoming numb with local anesthetic alone",
  "You find it hard to sit still through a longer appointment",
  "You need several procedures and want to discuss a more comfortable plan",
  "You have delayed dental care because of fear or a previous experience",
];
---

<InteriorLayout
  title="Sedation Dentistry in Independence | Eastland Family Dental"
  description="Sedation dentistry at Eastland Family Dental helps anxious patients relax, with care supported by a board-eligible anesthesiologist in Independence, MO."
  path={path}
  eyebrow="Sedation dentistry"
  heading="A calmer, more comfortable way to receive dental care."
  intro="Dental visits can feel stressful or overwhelming. Sedation dentistry can help you relax while your care team plans each step around your health, comfort, and treatment needs."
  additionalStructuredData={additionalStructuredData}
>
  <nav class="px-4 pb-2" aria-label="Breadcrumb">
    <ol class="mx-auto flex max-w-7xl flex-wrap items-center gap-2 text-sm font-semibold text-body">
      <li><a class="text-blue hover:underline" href="/">Home</a></li>
      <li aria-hidden="true">/</li>
      <li><a class="text-blue hover:underline" href="/procedures/">Procedures</a></li>
      <li aria-hidden="true">/</li>
      <li aria-current="page">Sedation Dentistry</li>
    </ol>
  </nav>

  <section class="overflow-x-clip px-4 py-10 sm:py-16">
    <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-[1.15fr_.85fr] lg:items-start lg:gap-20">
      <div class="reveal reveal-left">
        <p class="text-xs font-bold tracking-[.2em] text-eucalyptus uppercase">Comfort planned around you</p>
        <h2 class="mt-4 font-heading text-4xl leading-tight sm:text-5xl">Sedation begins with a conversation.</h2>
        <div class="mt-7 space-y-5 text-lg leading-relaxed text-body">
          <p>Before treatment, the team will review your health history, medications, concerns, and the procedure being planned. That information helps determine whether sedation is appropriate and what preparation or recovery instructions you may need.</p>
          <p>The goal is not simply to get through an appointment. It is to help you feel informed, supported, and as comfortable as possible from the first conversation through the end of your visit.</p>
        </div>
      </div>

      <aside class="reveal reveal-right rounded-4xl bg-air p-7 sm:rounded-5xl sm:p-9" aria-labelledby="anesthesiologist-title">
        <p class="text-xs font-bold tracking-[.2em] text-blue uppercase">An added level of support</p>
        <h2 id="anesthesiologist-title" class="mt-4 font-heading text-3xl leading-tight sm:text-4xl">A board-eligible anesthesiologist supports sedation care at Eastland.</h2>
        <p class="mt-5 text-lg leading-relaxed text-body">This anesthesia professional can focus on comfort and monitoring while the dentist focuses on treatment. The exact care team and monitoring plan will be explained before your procedure.</p>
      </aside>
    </div>
  </section>

  <section class="bg-navy px-4 py-12 text-white sm:py-16">
    <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[.72fr_1.28fr] lg:gap-20">
      <div class="reveal reveal-left">
        <p class="text-xs font-bold tracking-[.2em] text-air uppercase">A lighter comfort option</p>
        <h2 class="mt-4 font-heading text-4xl leading-tight sm:text-5xl">Nitrous oxide for children and adults.</h2>
      </div>
      <div class="reveal reveal-right border-t border-white/20 pt-7 text-lg leading-relaxed text-white/75">
        <p>Nitrous oxide, often called laughing gas, is available when appropriate. It is breathed through a small mask and is intended to help you feel calmer while remaining awake and able to communicate with the team.</p>
        <p class="mt-5">Every patient is different. Your dental team will discuss whether nitrous oxide fits your visit and explain what to expect before, during, and after treatment. If you are interested in another level of sedation, ask which options are available for your specific needs.</p>
      </div>
    </div>
  </section>

  <section class="px-4 py-12 sm:py-16">
    <div class="mx-auto max-w-7xl">
      <div class="reveal max-w-3xl">
        <p class="text-xs font-bold tracking-[.2em] text-eucalyptus uppercase">Who sedation may help</p>
        <h2 class="mt-4 font-heading text-4xl leading-tight sm:text-5xl">Comfort support for more than dental anxiety.</h2>
        <p class="mt-5 text-lg leading-relaxed text-body">A sedation conversation may be useful when fear, sensitivity, or the length of treatment makes it harder to receive the care you need.</p>
      </div>
      <ul class="mt-9 grid border-t border-navy/15 sm:grid-cols-2 lg:grid-cols-3">
        {reasons.map((reason, index) => (
          <li class:list={["reveal grid grid-cols-[auto_1fr] gap-4 border-b border-navy/15 py-6 text-lg leading-relaxed text-body", index % 3 !== 0 && "lg:border-l lg:px-7", index % 2 !== 0 && "sm:border-l sm:pl-7 lg:pl-7"]} style={`--reveal-delay:${(index % 3) * 60}ms`}>
            <span class="mt-2.5 h-2 w-2 rounded-full bg-blue" aria-hidden="true"></span>
            <span>{reason}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="overflow-x-clip bg-sand px-4 py-12 sm:py-16">
    <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[.92fr_1.08fr] lg:items-center lg:gap-20">
      <div class="reveal reveal-left rounded-4xl bg-white p-7 sm:rounded-5xl sm:p-10">
        <p class="text-xs font-bold tracking-[.2em] text-eucalyptus uppercase">For younger patients</p>
        <h2 class="mt-4 font-heading text-4xl leading-tight sm:text-5xl">A gentle approach for children.</h2>
        <p class="mt-5 text-lg leading-relaxed text-body">Eastland welcomes children and has nitrous oxide available when appropriate. The team considers each child’s age, health history, comfort, and treatment needs before recommending it.</p>
        <a class="mt-7 inline-flex font-bold text-blue" href="/procedures/pediatric-dentistry/">Explore children’s dentistry <span class="ml-2" aria-hidden="true">→</span></a>
      </div>
      <div class="reveal reveal-right">
        <p class="text-xs font-bold tracking-[.2em] text-eucalyptus uppercase">Planning and preparation</p>
        <h2 class="mt-4 font-heading text-4xl leading-tight sm:text-5xl">Your health and comfort come first.</h2>
        <p class="mt-5 text-lg leading-relaxed text-body">Tell the team about your medications, allergies, health conditions, pregnancy, previous anesthesia experiences, and any questions you have. Preparation, monitoring, transportation, and recovery instructions depend on the sedation plan and will be reviewed with you in advance.</p>
        <a class="mt-7 inline-flex font-bold text-blue" href="/procedures/oral-maxillofacial-surgery/">Learn about oral surgery <span class="ml-2" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="px-4 py-12 sm:py-16" aria-labelledby="sedation-faq-title">
    <div class="mx-auto max-w-4xl">
      <p class="reveal text-center text-xs font-bold tracking-[.2em] text-eucalyptus uppercase">Frequently asked questions</p>
      <h2 id="sedation-faq-title" class="reveal mt-4 text-center font-heading text-4xl leading-tight sm:text-5xl">What to know before your visit.</h2>
      <div class="mt-9 space-y-3">
        {faqs.map((item, index) => (
          <details class="reveal glow rounded-3xl bg-white p-5 sm:p-6" style={`--reveal-delay:${(index % 3) * 60}ms`}>
            <summary class="cursor-pointer font-bold text-navy">{item.question}</summary>
            <p class="mt-3 leading-relaxed text-body">{item.answer}</p>
          </details>
        ))}
      </div>
      <div class="reveal mt-9 flex flex-col justify-center gap-3 sm:flex-row">
        <a class="rounded-full bg-blue px-7 py-4 text-center font-bold text-white" href={appointmentHref}>Request an appointment</a>
        <a class="rounded-full bg-air px-7 py-4 text-center font-bold text-navy" href={practice.phoneHref}>Call {practice.phoneDisplay}</a>
      </div>
    </div>
  </section>
</InteriorLayout>
