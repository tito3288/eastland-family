---
import InteriorLayout from "../../../layouts/InteriorLayout.astro";
import { team } from "../../../lib/team";
---

<InteriorLayout
  title="Meet the Team | Eastland Family Dental"
  description="Meet the dentist, hygienists, dental assistants, and support professionals at Eastland Family Dental."
  path="/our-practice/meet-the-team/"
  eyebrow="Meet the team"
  heading="The people behind your care."
  intro="A friendly group of dental professionals working together to make each visit organized, comfortable, and personal."
>
  <section class="px-4 py-10 sm:py-16">
    <div class="mx-auto max-w-7xl">
      <div class="reveal grid gap-7 border-y border-navy/15 py-7 lg:grid-cols-[.7fr_1.3fr] lg:gap-16">
        <p class="text-xs font-bold tracking-[.2em] text-eucalyptus uppercase">One coordinated team</p>
        <p class="max-w-3xl text-lg leading-relaxed text-body">From preventive visits to more involved treatment, the clinical and support team share information, answer questions, and help patients know what comes next.</p>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {team.map((member, index) => (
          <article class="reveal" style={`--reveal-delay:${(index % 4) * 60}ms`}>
            {member.profileHref ? (
              <a class="group block" href={member.profileHref}>
                <img src={member.image} alt={member.name} width="500" height="500" loading={index === 0 ? "eager" : "lazy"} decoding="async" class="aspect-square w-full rounded-4xl bg-air object-cover transition duration-300 group-hover:-translate-y-1 sm:rounded-5xl" />
                <h2 class="mt-5 text-2xl font-bold text-navy">{member.name}</h2>
                <p class="mt-1 font-semibold text-blue">{member.role}</p>
                <p class="mt-3 text-sm font-bold text-body">Read Dr. Ashworth’s story <span aria-hidden="true">→</span></p>
              </a>
            ) : (
              <>
                <img src={member.image} alt={member.name} width="500" height="500" loading="lazy" decoding="async" class="aspect-square w-full rounded-4xl bg-air object-cover sm:rounded-5xl" />
                <h2 class="mt-5 text-2xl font-bold text-navy">{member.name}</h2>
                <p class="mt-1 font-semibold text-blue">{member.role}</p>
              </>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>
</InteriorLayout>
