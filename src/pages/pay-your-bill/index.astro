---
import InteriorLayout from "../../layouts/InteriorLayout.astro";
import { practice } from "../../lib/practice";
---

<InteriorLayout
  title="Pay Your Bill | Eastland Family Dental"
  description="Access the online payment portal for Eastland Family Dental or call the office with billing questions."
  path="/pay-your-bill/"
  eyebrow="Online payments"
  heading="A simple way to pay your bill."
  intro="Use Eastland Family Dental’s external payment portal to make an online payment. If you have a question about your balance, please call the office before submitting payment."
>
  <section class="px-4 py-10 sm:py-14">
    <div class="reveal reveal-zoom mx-auto max-w-5xl rounded-4xl bg-navy p-6 text-white sm:rounded-6xl sm:p-10 lg:p-14">
      <div class="grid gap-8 lg:grid-cols-[1.1fr_.9fr] lg:items-center">
        <div>
          <p class="text-xs font-bold tracking-[.2em] text-air uppercase">External payment portal</p>
          <h2 class="mt-4 font-heading text-4xl leading-tight md:text-5xl">Continue to online bill pay.</h2>
          <p class="mt-5 text-lg leading-relaxed text-white/75">The payment button opens the practice’s external bill-payment page in a new tab.</p>
          <a class="mt-8 inline-flex rounded-full bg-white px-7 py-4 font-bold text-navy" href={practice.billPayUrl} target="_blank" rel="noopener noreferrer">Open payment portal ↗</a>
        </div>
        <div class="border-t border-white/20 pt-7 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-10">
          <h3 class="text-2xl font-bold text-white">Need help first?</h3>
          <p class="mt-3 leading-relaxed text-white/70">For questions about a statement, balance, or payment amount, contact the office directly.</p>
          <a class="mt-6 inline-flex rounded-full bg-air px-6 py-4 text-center font-bold text-navy" href={practice.phoneHref}>Call {practice.phoneDisplay}</a>
        </div>
      </div>
    </div>
  </section>
</InteriorLayout>
