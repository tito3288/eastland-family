---
import "../styles/global.css";
import { theme } from "../lib/theme.config";
import { practice } from "../lib/practice";

interface Props {
  title?: string;
  description?: string;
  canonical?: string | false;
  image?: string;
  noindex?: boolean;
  additionalStructuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = "Dentist Independence, MO | Eastland Family Dental | Near You",
  description = "Eastland Family Dental is a family dentist located in Independence, MO. We are welcoming new patients, contact our team today!",
  canonical,
  image = "/og.png",
  noindex = false,
  additionalStructuredData,
} = Astro.props;

const siteOrigin = Astro.site ?? new URL("https://www.eastlandfamilydental.com");
const canonicalUrl = canonical === false ? undefined : canonical ?? new URL(Astro.url.pathname, siteOrigin).toString();
const ogImage = new URL(image, siteOrigin).toString();
const dentistStructuredData = {
  "@context": "https://schema.org",
  "@type": "Dentist",
  name: practice.name,
  url: siteOrigin.toString(),
  image: ogImage,
  logo: new URL("/images/eastland-logo.png", siteOrigin).toString(),
  telephone: practice.phoneDisplay,
  email: practice.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: practice.address.street,
    addressLocality: "Independence",
    addressRegion: "MO",
    postalCode: "64055",
    addressCountry: "US",
  },
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday"],
    opens: "07:00",
    closes: "16:30",
  },
};
const structuredData = [
  dentistStructuredData,
  ...(Array.isArray(additionalStructuredData)
    ? additionalStructuredData
    : additionalStructuredData
      ? [additionalStructuredData]
      : []),
];
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google Tag Manager -->
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-KP6L8X3F');
    </script>
    <!-- End Google Tag Manager -->
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/images/eastland-logo.png" />
    <link rel="apple-touch-icon" href="/images/eastland-logo.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={practice.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Eastland Family Dental — Healthy smiles, cared for gently." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Eastland Family Dental — Healthy smiles, cared for gently." />
    <meta name="theme-color" content={theme.colors.navy} />
    {!noindex && structuredData.map((entry) => <script is:inline type="application/ld+json" set:html={JSON.stringify(entry)} />)}
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body class="bg-porcelain text-navy font-body antialiased">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KP6L8X3F" height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <slot />
  </body>
</html>
