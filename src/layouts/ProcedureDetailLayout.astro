---
import InteriorLayout from "./InteriorLayout.astro";
import type { ProcedureCategory } from "../lib/procedures";
import type { ProcedureDetail } from "../lib/procedure-details/types";

interface Props {
  detail: ProcedureDetail;
  category: ProcedureCategory;
  related: ProcedureDetail[];
}

const { detail, category, related } = Astro.props;
const path = `/procedures/${detail.categorySlug}/${detail.slug}/`;
---

<InteriorLayout
  title={`${detail.title} | Eastland Family Dental`}
  description={detail.intro}
  path={path}
  eyebrow={`${category.shortTitle} · ${detail.eyebrow}`}
  heading={detail.heading}
  intro={detail.intro}
>
  <section class="overflow-x-clip px-4 py-10 sm:py-16">
    <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-[.48fr_1fr] lg:gap-20">
      <aside class="reveal reveal-left lg:sticky lg:top-32 lg:self-start">
        <a class="text-sm font-bold text-blue" href={`/procedures/${category.slug}/`}>← Back to {category.title}</a>
        <p class="mt-8 text-xs font-bold tracking-[.2em] text-eucalyptus uppercase">General information</p>
        <p class="mt-4 max-w-sm leading-relaxed text-body">A dental examination is needed to determine whether this treatment fits your tooth, health history, symptoms, and goals.</p>
      </aside>

      <div class="reveal reveal-right border-t border-navy/15">
        <section class="border-b border-navy/15 py-8 sm:py-10">
          <h2 class="font-heading text-3xl leading-tight sm:text-4xl">{detail.overviewTitle}</h2>
          {detail.overview.map((paragraph) => <p class="mt-5 text-lg leading-relaxed text-body">{paragraph}</p>)}
        </section>

        {detail.sections.map((section) => (
          <section class="border-b border-navy/15 py-8 sm:py-10">
            <h2 class="font-heading text-3xl leading-tight sm:text-4xl">{section.heading}</h2>
            {section.paragraphs?.map((paragraph) => <p class="mt-5 text-lg leading-relaxed text-body">{paragraph}</p>)}
            {section.bullets && (
              <ul class="mt-6 space-y-4">
                {section.bullets.map((bullet) => (
                  <li class="grid grid-cols-[auto_1fr] gap-3 text-lg leading-relaxed text-body">
                    <span class="mt-2.5 h-2 w-2 rounded-full bg-blue" aria-hidden="true"></span>
                    <span>{bullet}</span>
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-air px-4 py-12 sm:py-16">
    <div class="mx-auto max-w-7xl">
      <p class="reveal text-xs font-bold tracking-[.2em] text-blue uppercase">Three things to remember</p>
      <div class="mt-6 grid border-t border-navy/15 md:grid-cols-3">
        {detail.keyPoints.map((point, index) => (
          <div class:list={["reveal py-7 md:px-8", index > 0 && "border-t border-navy/15 md:border-t-0 md:border-l"]} style={`--reveal-delay:${index * 70}ms`}>
            <p class="font-heading text-2xl leading-snug text-navy">{point}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="overflow-x-clip px-4 py-12 sm:py-16">
    <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[.72fr_1.28fr] lg:gap-20">
      <div class="reveal reveal-left">
        <p class="text-xs font-bold tracking-[.2em] text-eucalyptus uppercase">Reviewed references</p>
        <h2 class="mt-4 font-heading text-3xl leading-tight sm:text-4xl">Clear sources for a more informed conversation.</h2>
        <div class="mt-6 flex flex-col items-start gap-3">
          {detail.sources.map((source) => (
            <a class="font-bold text-blue underline decoration-blue/30 underline-offset-4 hover:decoration-blue" href={source.href} target="_blank" rel="noreferrer">
              {source.label}<span class="sr-only"> (opens in a new tab)</span>
            </a>
          ))}
        </div>
      </div>

      <div class="reveal reveal-right border-t border-navy/15">
        <p class="border-b border-navy/15 py-5 text-xs font-bold tracking-[.2em] text-eucalyptus uppercase">Related in {category.title}</p>
        {related.map((item) => (
          <a class="group flex items-center justify-between gap-5 border-b border-navy/15 py-5 font-bold text-navy" href={`/procedures/${item.categorySlug}/${item.slug}/`}>
            <span>{item.title}</span><span class="text-blue transition group-hover:translate-x-1" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</InteriorLayout>
